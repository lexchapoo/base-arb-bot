# Base mainnet / Flashblocks
CHAIN_ID=8453
BASE_HTTP_RPCS=
# Comma-separated independent Base HTTPS RPCs. If empty, BASE_HTTP_RPC is used.
# Shared secret required by the pool-curation endpoints (/pools/select, /pools/register,
# DELETE /pools/{address}), sent as `Authorization: Bearer <token>`. Those endpoints rewrite
# the durable curated set and the live routing graph, so they are refused entirely while
# this is empty. Generate with: openssl rand -hex 32
#
# Must be ASCII with no surrounding whitespace: HTTP header values are ASCII, and the
# presented half is stripped before comparison, so a token violating either can never be
# matched by any client. Either defect is logged as an error at boot and answered with a
# 503 naming it, rather than a 401 indistinguishable from a wrong secret.
# `openssl rand -hex 32` always satisfies this.
OPERATOR_API_TOKEN=

RPC_CONSENSUS_REQUIRED=true
# How the pending-state (decision-state) cross-check is enforced when consensus is required.
#   off     - sealed-block agreement only; the pending state the trade is priced on is unchecked
#   observe - cross-check pending on the second provider and warn on divergence (default)
#   strict  - reject on any pending divergence. Correct only where both endpoints share a
#             mempool view; otherwise it rejects nearly every real opportunity.
RPC_CONSENSUS_PENDING_MODE=observe
RPC_PROBE_TIMEOUT_SECONDS=2.5
RPC_HTTP_TIMEOUT_MS=8000
RECEIPT_POLL_MS=1000
RECEIPT_TIMEOUT_SECONDS=45
BASE_HTTP_RPC=https://mainnet.base.org
BASE_FLASHBLOCKS_WS=
BASE_WS_RPC=

# pendingLogs is intentionally scoped. Populate this from live pool discovery.
WATCHED_POOL_ADDRESSES=
WATCHED_TOPIC0S=
ALLOW_UNFILTERED_PENDING_LOGS=false
PYTHON_ROUTE_TRIGGER_URL=http://python-api:8080/route-trigger
# Bounded in-flight route-trigger POSTs. Each in-flight POST holds a concurrency slot, so the
# per-request timeout below is what stops a hung POST from wedging every slot.
MAX_INFLIGHT_ROUTE_TRIGGERS=6
ROUTE_TRIGGER_TIMEOUT_SECONDS=15
# Reconnect the pending-logs websocket if no message arrives within this many seconds
# (detects a silently-stalled subscription). A healthy Base feed sends newHeads roughly every 2s.
WS_IDLE_TIMEOUT_SECONDS=30

DATABASE_URL=postgresql+asyncpg://arb:arb@postgres:5432/arb
DRY_RUN=true
LIVE_TRADING=false
LIVE_TRADING_ACK=
AUTO_SUBMIT_ROUTES=true
MAX_ROUTE_HOPS=3
MAX_QUOTE_EVALUATIONS=24
MAX_STATE_AGE_BLOCKS=1
# Block tag the sizing path prices against: "pending" (production -- Flashblocks
# pre-confirmation state, the premise of the strategy) or "latest" (confirmed state,
# strictly worse information, for nodes that cannot serve `pending` quickly).
QUOTE_BLOCK_TAG=pending
QUOTE_TIMEOUT_SECONDS=4
EXECUTION_RPC_TIMEOUT_SECONDS=8
RUST_EXECUTOR_URL=http://rust-executor:8081
PYTHON_API_PORT=8080
RUST_API_PORT=8081

# Required verified deployments. Do not insert guessed addresses.
# The deployed executor. Also drives the live-proxy upgrade rehearsal in
# contracts/test/BaseProxyUpgradeFork.t.sol -- with this and EXECUTOR_OWNER_ADDRESS set, the
# fork suite forks Base, upgrades the real proxy and checks owner/POOL/paused survive before
# you do it for real. Left blank here on purpose: this repository is public, and nothing in it
# needs to name a specific mainnet deployment. Unset means those tests skip, never pass.
EXECUTOR_ADDRESS=
EXECUTOR_OWNER_ADDRESS=
# Which venue routes borrow their principal from: "aave" (Aave v3, 5bp premium) or "morpho"
# (Morpho Blue, no premium at all -- its core is immutable, so unlike a governance-settable
# fee this cannot be switched on later). On Base, Morpho also holds roughly 10x the WETH the
# Aave pool does. Left on "aave" by default: switching venues is an execution change and
# should be a deliberate one, ideally after a shadow run comparing the two.
FLASH_PROVIDER=aave
# Shadow only: price every route against the *other* provider as well and record the paired
# comparison in the evaluation row. Doubles the RPC cost of an evaluation, so it is refused
# unless DRY_RUN=true and LIVE_TRADING=false. Read the result in the shadow report under
# database.flash_providers.comparison -- `would_unblock` is the number that matters: routes
# the baseline's premium made unprofitable that the other venue would have cleared.
SHADOW_COMPARE_PROVIDERS=false
# Morpho Blue singleton on Base. Required only when FLASH_PROVIDER=morpho -- a Morpho route
# with this unset is refused outright rather than falling back to Aave and quietly billing a
# premium that was not asked for. Verify before use.
MORPHO_ADDRESS=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb
#
# Upgrading an already-deployed proxy to gain Morpho support (two phases, each estimable):
#   1. scripts_prepare_deployment.py --upgrade-proxy $EXECUTOR_ADDRESS --nonce <pending> \
#        --output plans/upgrade-1.json
#      scripts_deploy_via_signer.py --plan plans/upgrade-1.json --broadcast
#   2. re-run with --implementation <address deployed in step 1> and a fresh --nonce, then
#      broadcast that plan. Phase 2 upgrades and calls setMorpho in ONE transaction, so there
#      is no window in which the proxy is upgraded but MORPHO is still zero.
#   3. FLASH_PROVIDER=morpho scripts_verify_runtime.py  -- must exit 0 before switching
AAVE_POOL=
BASE_WETH=
UNISWAP_V3_QUOTER_V2=
AERODROME_ROUTER=
AERODROME_FACTORY=0x420DD381b31aEf6683db6B902084cB0FFECe40Da
AERODROME_ADAPTER_ADDRESS=
UNISWAP_V3_ADAPTER_ADDRESS=
# Aerodrome Slipstream (concentrated liquidity). Intentionally blank: fill in only with
# independently verified Base deployments. While blank, Slipstream pools are neither
# discovered nor routed -- nothing is guessed.
AERODROME_SLIPSTREAM_FACTORY=
AERODROME_SLIPSTREAM_QUOTER=
AERODROME_SLIPSTREAM_ROUTER=
AERODROME_SLIPSTREAM_ADAPTER_ADDRESS=
# Base protocol-defined GasPriceOracle predeploy; code is verified before use.
GAS_PRICE_ORACLE=0x420000000000000000000000000000000000000F

# Rust live-submission boundary. Leave blank for dry-run/read-only operation.
EXTERNAL_SIGNER_URL=
EXTERNAL_SIGNER_ADDRESS=
# Required for live signing: signer-gateway rejects unauthenticated requests with 401.
# File must be chmod 600 (not group/world readable).
EXTERNAL_SIGNER_BEARER_TOKEN_FILE=
SUBMISSION_PROVIDER_NAME=base-flashblocks

# Packed multi-route automatic submission
PACKED_MULTIROUTE_ENABLED=true
PACKED_MAX_CANDIDATES=8

# v0.8 Flashblock transaction stream (optional causal source-transaction feed)
# pendingLogs remains the bandwidth-efficient default. Enable this only on a Flashblocks-aware WSS provider.
FLASHBLOCK_TX_STREAM_ENABLED=false

# Adaptive submission gate. Values are integer-only execution policy inputs.
ADAPTIVE_SUBMISSION_ENABLED=true
OPPORTUNITY_SURVIVAL_WINDOW_MS=800
EXPECTED_EXECUTION_LATENCY_MS=120
INCLUSION_PROBABILITY_BPS=9000
EXPECTED_FAILURE_COST_ASSET_UNITS=0
SUBMISSION_SAFETY_MARGIN_ASSET_UNITS=0

# v0.9 automatic verified pool discovery
AUTO_POOL_DISCOVERY_ENABLED=true
POOL_DISCOVERY_REFRESH_SECONDS=60
POOL_DISCOVERY_FROM_BLOCK=0
POOL_DISCOVERY_LOG_CHUNK_BLOCKS=20000
POOL_DISCOVERY_CONCURRENCY=16
# Optional separate endpoint for discovery's verification eth_calls (get_code/token0/
# factory). Log reads need history; verification only needs a synced head, and its fan-out
# is what trips rate limits -- so a local node here with an archive provider on
# BASE_HTTP_RPC is the split that scales. Empty means "use the log endpoint for both".
# This is the service-side equivalent of scripts/backfill_uniswap_pools.py --call-rpc.
POOL_DISCOVERY_CALL_RPC_URL=
# Split-RPC discovery only: how far the verification endpoint may trail the log endpoint
# before its get_code/token0 answers are treated as untrustworthy. A lagging node reports
# recently created pools as non-existent, which silently drops them. Inert while
# POOL_DISCOVERY_CALL_RPC_URL is empty -- one endpoint cannot lag itself.
POOL_DISCOVERY_MAX_CALL_LAG_BLOCKS=64
# Optional comma-separated token filter. Empty means register every verified discovered pool.
POOL_DISCOVERY_TOKEN_ALLOWLIST=
# Official Base deployments; override only after independent verification.
UNISWAP_V3_FACTORY=0x33128a8fC17869897dcE68Ed026d694621f6FDfD
# AERODROME_FACTORY already points to official PoolFactory above.
PYTHON_POOL_REGISTRY_URL=http://python-api:8080/pools/addresses
WATCH_POOL_REFRESH_SECONDS=30
# Split large discovered registries into multiple filtered subscriptions.
WATCH_POOL_SUBSCRIPTION_CHUNK_SIZE=200

# v0.12 shadow intelligence (advisory only; never constructs or submits transactions)
SHADOW_POLICY_ENABLED=true
SHADOW_MIN_SAMPLES=20
SHADOW_HISTORY_LIMIT=500
SHADOW_NOW_CAPTURE_BPS=6000
SHADOW_NOW_SURVIVAL_BPS=7000
SHADOW_WAIT_SURVIVAL_BPS=3500
