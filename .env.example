# Base mainnet / Flashblocks
CHAIN_ID=8453
BASE_HTTP_RPC=https://mainnet.base.org
BASE_FLASHBLOCKS_WS=
BASE_WS_RPC=

# pendingLogs is intentionally scoped. Populate this from live pool discovery.
WATCHED_POOL_ADDRESSES=
WATCHED_TOPIC0S=
WATCHED_POOLS_JSON=
ALLOW_UNFILTERED_PENDING_LOGS=false
PYTHON_ROUTE_TRIGGER_URL=http://python-api:8080/route-trigger
MAX_INFLIGHT_ROUTE_TRIGGERS=6
# Per-request timeout for route-trigger POSTs (seconds). Bounds how long a
# single in-flight POST may hold a concurrency slot before it is abandoned.
ROUTE_TRIGGER_TIMEOUT_SECONDS=15
# Reconnect the pending-logs websocket if no message arrives within this many
# seconds (detects a silently-stalled subscription). A healthy Base feed sends
# newHeads roughly every 2s.
WS_IDLE_TIMEOUT_SECONDS=30

DATABASE_URL=postgresql+asyncpg://arb:arb@postgres:5432/arb
DRY_RUN=true
LIVE_TRADING=false
LIVE_TRADING_ACK=
AUTO_SUBMIT_ROUTES=true
MAX_ROUTE_HOPS=3
MAX_QUOTE_EVALUATIONS=4
QUOTE_CONCURRENCY=8
MAX_STATE_AGE_BLOCKS=1
QUOTE_TIMEOUT_SECONDS=4
EXECUTION_RPC_TIMEOUT_SECONDS=8
RUST_EXECUTOR_URL=http://rust-executor:8085
PYTHON_API_PORT=8080
RUST_API_PORT=8085
SHADOW_OBSERVATION_SECONDS=3600
SHADOW_POLL_INTERVAL_SECONDS=5
SHADOW_DATABASE_URL=postgresql+asyncpg://arb:arb@localhost:5432/arb
SHADOW_REPORT_DIR=reports/shadow
SHADOW_RUST_HEALTH_URL=http://localhost:8085/health

# Required verified deployments. Do not insert guessed addresses.
EXECUTOR_ADDRESS=
EXECUTOR_OWNER_ADDRESS=
AAVE_POOL=
BASE_WETH=
UNISWAP_V3_QUOTER_V2=
UNISWAP_V3_SWAP_ROUTER_02=
AERODROME_ROUTER=
AERODROME_FACTORY=
AERODROME_ADAPTER_ADDRESS=
UNISWAP_V3_ADAPTER_ADDRESS=
DEPLOY_ALLOWED_TOKENS=
# Base protocol-defined GasPriceOracle predeploy; code is verified before use.
GAS_PRICE_ORACLE=0x420000000000000000000000000000000000000F

# Rust live-submission boundary. Leave blank for dry-run/read-only operation.
EXTERNAL_SIGNER_URL=
EXTERNAL_SIGNER_ADDRESS=
EXTERNAL_SIGNER_BEARER_TOKEN_FILE=
SUBMISSION_PROVIDER_NAME=base-flashblocks

# Packed multi-route automatic submission
PACKED_MULTIROUTE_ENABLED=true
PACKED_MAX_CANDIDATES=8
