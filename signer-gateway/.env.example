CHAIN_ID=8453
SIGNER_GATEWAY_ADDRESS=
EXECUTOR_ADDRESS=
SIGNER_GATEWAY_PORT=9000

# Clef should expose only its local Unix socket to this gateway.
CLEF_IPC_PATH=/run/clef/clef.ipc
# Allows time for careful manual approval of deployment transactions in Clef.
CLEF_SIGN_TIMEOUT_SECONDS=300
CLEF_MAX_RESPONSE_BYTES=1048576

# Create outside the repository with 0600 permissions and at least 32 random characters.
SIGNER_GATEWAY_TOKEN_FILE=

# Both capabilities fail closed until deliberately enabled for a reviewed phase.
SIGNER_ALLOW_EXECUTION=false
SIGNER_ALLOW_DEPLOYMENT=false
SIGNER_DEPLOYMENT_PLAN_PATH=

SIGNER_MAX_GAS=3000000
SIGNER_MAX_DEPLOYMENT_GAS=6000000
SIGNER_MAX_FEE_PER_GAS_WEI=5000000000
