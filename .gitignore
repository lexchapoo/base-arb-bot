.env
# Backups and per-environment copies: .gitignore matches literally, so a bare `.env`
# rule leaves .env.bak.<ts> (written by the provisioning scripts, and carrying live
# RPC keys and database credentials) one `git add -A` away from being committed.
.env.*
!.env.example
.venv/
__pycache__/
.pytest_cache/
target/
contracts/cache/
contracts/out/

# Ruflo / claude-flow runtime state (not source)
.claude-flow/
.claude/
.swarm/
.hive-mind/

# Echidna / crytic fuzzing artifacts
echidna-corpus/
crytic-export/
contracts/echidna-corpus/
contracts/crytic-export/

# Foundry dependencies (restored by scripts/setup_linux.sh via `forge install`)
contracts/lib/

# graphify knowledge-graph output (regenerated by `graphify update .`)
graphify-out/
